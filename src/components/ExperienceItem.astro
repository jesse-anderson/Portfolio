---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const { title, company, location, startDate, endDate, current, volunteer, bullets, techStack } = entry.data;

function formatDate(iso?: string | null): string {
  if (!iso) return '';
  const [yyyy, mm] = iso.split('-');
  if (!yyyy) return iso;
  if (!mm) return yyyy;
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const idx = parseInt(mm, 10) - 1;
  return `${months[idx] ?? mm} ${yyyy}`;
}

const dateRange = current
  ? `${formatDate(startDate)} – Present`
  : `${formatDate(startDate)} – ${formatDate(endDate)}`;
const articleClass = [
  'grid md:grid-cols-12 gap-4 md:gap-8 border-t border-ink/10 py-8',
  volunteer ? 'bg-paper-alt/30' : '',
].filter(Boolean).join(' ');
---

<article class={articleClass}>
  <div class="md:col-span-3">
    <p class="text-xs font-mono text-ink-subtle">{dateRange}</p>
    {location && <p class="mt-1 text-xs text-ink-subtle">{location}</p>}
  </div>
  <div class="md:col-span-9">
    <h3 class="text-base font-semibold text-ink-muted">
      {title} <span class="font-normal">· {company}</span>
      {volunteer && <span class="ml-2 text-xs text-ink-subtle" aria-label="Volunteer position">❤️</span>}
    </h3>
    <ul class="mt-3 space-y-2 text-sm text-ink-muted leading-relaxed">
      {bullets.map((b) => (
        <li class="pl-4 relative before:content-['•'] before:absolute before:left-0 before:text-ink-subtle">{b}</li>
      ))}
    </ul>
    {techStack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-subtle font-mono">
        {techStack.map((t) => <li>{t}</li>)}
      </ul>
    )}
  </div>
</article>
