---
import { profile } from '../data/profile';

const links = [
  { href: profile.homepage, label: 'jesse-anderson.net' },
  { href: profile.blog, label: 'Blog' },
  { href: profile.tools, label: 'Tools' },
  { href: profile.github, label: 'GitHub' },
  { href: profile.linkedin, label: 'LinkedIn' },
  { href: profile.orcid, label: 'ORCID' },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink/10">
  <div class="container-page py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <p class="text-sm text-ink-muted">
      © {year} {profile.name} · Chicago, IL
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink-muted hover:text-ink transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
