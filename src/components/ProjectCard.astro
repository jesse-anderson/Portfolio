---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, blurb, techStack, links, image, imageAlt } = project.data;
const { Content } = await project.render();
const hasDetails = project.body.trim().length > 0;

const primary = links[0];
---

<article class="border-t border-ink/10 py-6">
  <div class={image ? 'grid md:grid-cols-12 gap-4' : ''}>
    {image && (
      <div class="md:col-span-3">
        <img
          src={image}
          alt={imageAlt ?? title}
          loading="lazy"
          class="w-full aspect-[4/3] object-cover rounded border border-ink/10"
        />
      </div>
    )}
    <div class={image ? 'md:col-span-9' : ''}>
      <h3 class="text-base font-semibold text-ink">
        {primary ? (
          <a href={primary.url} target="_blank" rel="noopener noreferrer" class="link-underline">
            {title} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          title
        )}
      </h3>
      <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-subtle font-mono">
        {techStack.slice(0, 5).map((t) => <li>{t}</li>)}
      </ul>
      <p class="mt-2 text-sm text-ink-muted leading-relaxed">{blurb}</p>

      {hasDetails && (
        <details class="featured-details mt-3">
          <summary class="cursor-pointer text-sm font-medium text-ink hover:text-accent transition-colors">
            How it works
          </summary>
          <div class="prose-lite mt-3">
            <Content />
          </div>
        </details>
      )}

      {links.length > 1 && (
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
          {
            links.slice(1).map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-subtle hover:text-ink"
                >
                  {link.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      )}
    </div>
  </div>
</article>
