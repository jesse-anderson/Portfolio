---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, blurb, techStack, links, image, imageAlt } = project.data;

const primary = links[0];
---

<article class="border-t border-ink/10 py-6">
  {image && (
    <div class="grid md:grid-cols-12 gap-4">
      <div class="md:col-span-3">
        <img
          src={image}
          alt={imageAlt ?? title}
          class="w-full aspect-[4/3] object-cover rounded border border-ink/10"
        />
      </div>
      <div class="md:col-span-9">
        <h3 class="text-base font-semibold text-ink">
          {primary ? (
            <a href={primary.url} target="_blank" rel="noopener noreferrer" class="link-underline">
              {title} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            title
          )}
        </h3>
        <div class="mt-2">
          <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-subtle font-mono">
            {techStack.slice(0, 5).map((t) => <li>{t}</li>)}
          </ul>
          <p class="mt-2 text-sm text-ink-muted leading-relaxed">{blurb}</p>
        </div>
      </div>
    </div>
  )}
  {!image && (
    <>
      <h3 class="text-base font-semibold text-ink">
        {primary ? (
          <a href={primary.url} target="_blank" rel="noopener noreferrer" class="link-underline">
            {title} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          title
        )}
      </h3>
      <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-subtle font-mono">
        {techStack.slice(0, 5).map((t) => <li>{t}</li>)}
      </ul>
      <p class="mt-2 text-sm text-ink-muted leading-relaxed">{blurb}</p>
    </>
  )}
  {links.length > 1 && (
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
      {
        links.slice(1).map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-subtle hover:text-ink"
            >
              {link.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  )}
</article>
