---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<section id={id} class="container-page py-20 md:py-24 scroll-mt-20">
  <div class="max-w-prose mb-12">
    {eyebrow && (
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-ink-subtle">{eyebrow}</p>
    )}
    <h2 class="mt-2 text-2xl md:text-3xl font-semibold tracking-tight text-ink">{title}</h2>
    {description && (
      <p class="mt-4 text-base text-ink-muted leading-relaxed">{description}</p>
    )}
  </div>
  <slot />
</section>
