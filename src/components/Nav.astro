---
import { profile } from '../data/profile';

const links = [
  { href: '#featured', label: 'Featured' },
  { href: '#projects', label: 'Projects' },
  { href: '#publications', label: 'Publications' },
  { href: '#experience', label: 'Experience' },
  { href: '#blog', label: 'Blog' },
];
---

<header class="border-b border-ink/5 bg-paper/80 backdrop-blur sticky top-0 z-40">
  <nav class="container-page flex items-center justify-between h-14">
    <a href="/" class="text-sm font-medium tracking-tight">
      {profile.name}
    </a>
    <ul class="hidden md:flex items-center gap-7 text-sm text-ink-muted">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="hover:text-ink transition-colors">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={profile.resume}
      class="text-sm font-medium text-accent hover:text-accent-hover"
    >
      Résumé →
    </a>
  </nav>
</header>
