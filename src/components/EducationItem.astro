---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'education'>;
}

const { entry } = Astro.props;
const { degree, institution, location, gpa, bullets } = entry.data;
---

<article class="border-t border-ink/10 py-6">
  <div class="flex items-baseline justify-between gap-4 flex-wrap">
    <div>
      <h3 class="text-base font-semibold text-ink">{degree}</h3>
      <p class="text-sm text-ink-muted">
        {institution}{location && <span> · {location}</span>}
      </p>
    </div>
    {gpa && (
      <p class="text-xs font-mono text-ink-subtle">GPA {gpa}</p>
    )}
  </div>
  {bullets.length > 0 && (
    <ul class="mt-3 space-y-1.5 text-sm text-ink-muted leading-relaxed">
      {bullets.map((b) => (
        <li class="pl-4 relative before:content-['—'] before:absolute before:left-0 before:text-ink-subtle">{b}</li>
      ))}
    </ul>
  )}
</article>
