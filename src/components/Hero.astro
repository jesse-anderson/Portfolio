---
import { profile } from '../data/profile';

const ctas = [
  { href: profile.resume, label: 'Résumé', external: false },
  { href: `mailto:${profile.email}`, label: 'Email', external: false },
  { href: profile.github, label: 'GitHub', external: true },
  { href: profile.linkedin, label: 'LinkedIn', external: true },
  { href: profile.orcid, label: 'ORCID', external: true },
];
---

<section class="container-page pt-20 pb-24 md:pt-28 md:pb-32">
  <div class="max-w-prose">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-ink-subtle">
      {profile.role}
    </p>
    <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-ink">
      {profile.name}
    </h1>
    <p class="mt-7 text-lg leading-relaxed text-ink-muted">
      {profile.bio}
    </p>

    <dl class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-x-8 gap-y-5 border-y border-ink/10 py-6">
      {
        profile.highlights.map((h) => (
          <div>
            <dt class="text-xs uppercase tracking-wider text-ink-subtle">{h.label}</dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums text-ink">{h.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
      {
        ctas.map((cta) => (
          <li>
            <a
              href={cta.href}
              class="inline-flex items-center gap-1 link-underline text-ink"
              {...cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            >
              {cta.label}
              {cta.external && <span aria-hidden="true">↗</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-sm text-ink-muted">
      Currently at G5 Environmental. Open to conversations about Rust, data systems, and scientific computing.
    </p>
  </div>
</section>
