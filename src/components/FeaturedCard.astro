---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, blurb, techStack, image, imageAlt, links } = project.data;

const number = String(index + 1).padStart(2, '0');
---

<article class="group grid md:grid-cols-12 gap-6 md:gap-10 py-10 border-t border-ink/10 first:border-t-0">
  <div class="md:col-span-1">
    <span class="text-xs font-mono text-ink-subtle">{number}</span>
  </div>
  <div class="md:col-span-7">
    <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-ink">
      {title}
    </h3>
    <p class="mt-3 text-base text-ink-muted leading-relaxed">{blurb}</p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-subtle font-mono">
      {techStack.map((t) => <li>{t}</li>)}
    </ul>
    <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline text-ink"
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  {image && (
    <div class="md:col-span-4">
      <a
        href={links[0]?.url ?? '#'}
        target={links[0] ? '_blank' : undefined}
        rel={links[0] ? 'noopener noreferrer' : undefined}
        class="block overflow-hidden rounded-md border border-ink/10 bg-paper-alt"
      >
        <img
          src={image}
          alt={imageAlt ?? title}
          loading="lazy"
          class="w-full aspect-[4/3] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </a>
    </div>
  )}
</article>
